[Unit]
Description=Harness head "%i": a Claude Code REPL in tmux + the bridge that types into it
After=network.target

[Service]
Type=simple
Environment=HEAD_LANE=%i
Environment=HEAD_STATE_DIR=%h/.local/state/harness/%i
Environment=HEAD_SESSION=harness-head-%i
Environment=HEAD_SOCKET=%h/.local/state/harness/%i/head.sock
Environment=HEAD_LOG=%h/.local/state/harness/%i/bridge.log
Environment=HEAD_CWD=%h/heads/%i
# each head owns its tmux server (-L head-<name>): one crash of a shared server once took every REPL down with it
Environment=HEAD_TMUX_L=head-%i
# resume the lane's conversation; fall back to a fresh one only if there is none to continue
Environment="HEAD_CMD=claude --continue || claude"
# idle sleep: after this many seconds with no message, no key, an idle screen and nothing running under the REPL, the
# session is ended to free its memory; the next message (or any send on the socket) starts it again with --continue.
# 0 = never. 10800 = 3 h. The stage's Settings > Heads can keep chosen heads awake (always_on.json).
Environment=HEAD_IDLE_SLEEP_S=0
Environment=HEAD_ALWAYS_ON=%h/.local/state/harness/always_on.json
ExecStartPre=/bin/mkdir -p %h/.local/state/harness/%i
# say it loudly (in the topic) when this head would start a different claude than [head] cli; never blocks
ExecStartPre=-/usr/bin/python3 -B %h/harness/harness/cli_check.py
ExecStart=/usr/bin/python3 -B %h/harness/harness/head_bridge.py
# the tmux server holds the REPL and lives in this cgroup: stop/restart kills only the bridge
KillMode=process
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
